@model IEnumerable<BasicApplication.Models.Car>

<h1>Car Database</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Owner</th>
            <th>Brand</th>
            <th>Model</th>
            <th>Year</th>
            <th>Price</th>
            <th>Color</th>
            <th>Registration</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var car in Model)
        {
            <tr>
                <td>@car.Id</td>
                <td>@car.Owner</td>
                <td>@car.Brand</td>
                <td>@car.Model</td>
                <td>@car.ModelYear</td>
                <td>@car.Price.ToString("N2")</td>
                <td>@car.Color</td>
                <td>@car.RegistrationNumber</td>
            </tr>
        }
    </tbody>
</table>
